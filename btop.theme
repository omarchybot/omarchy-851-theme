# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0D122F"

# Main text color
theme[main_fg]="#FCF5D6"

# Title color for boxes
theme[title]="#FCF5D6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#757fbd"

# Background color of selected item in processes box. #252a44 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #252a44 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#252a44"

# Foreground color of selected item in processes box. Use #FCF5D6 so
# the row text stays readable on the lighter_bg highlight; the previous
# #757fbd produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#FCF5D6"

# Color of inactive/disabled text
theme[inactive_fg]="#606268"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #fcf7dc caps at #ffffff when the foreground is already pure white, so we
# just bind it to #FCF5D6 directly.
theme[graph_text]="#FCF5D6"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #252a44 collapsed to the main fg.
theme[meter_bg]="#252a44"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #787fc8 for a distinct accent instead of #fcf7dc which capped to white.
theme[proc_misc]="#787fc8"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a075a1"
theme[mem_box]="#f1bd9c"
theme[net_box]="#c4897f"
theme[proc_box]="#757fbd"

# Box divider line and small boxes line color
theme[div_line]="#606268"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#f1bd9c"
theme[temp_mid]="#ffdcab"
theme[temp_end]="#c4897f"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#787fc8"
theme[cpu_mid]="#757fbd"
theme[cpu_end]="#a075a1"

# Mem/Disk free meter
theme[free_start]="#a075a1"
theme[free_mid]="#757fbd"
theme[free_end]="#787fc8"

# Mem/Disk cached meter
theme[cached_start]="#757fbd"
theme[cached_mid]="#787fc8"
theme[cached_end]="#a075a1"

# Mem/Disk available meter
theme[available_start]="#ffdcab"
theme[available_mid]="#c4897f"
theme[available_end]="#c4897f"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#f1bd9c"
theme[used_mid]="#787fc8"
theme[used_end]="#757fbd"

# Download graph colors
theme[download_start]="#ffdcab"
theme[download_mid]="#c4897f"
theme[download_end]="#c4897f"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#f1bd9c"
theme[upload_mid]="#787fc8"
theme[upload_end]="#757fbd"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#787fc8"
theme[process_mid]="#757fbd"
theme[process_end]="#a075a1"
